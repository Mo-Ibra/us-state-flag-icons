{
  "name": "us-state-flag-icons",
  "version": "1.0.0",
  "description": "Vector US state and territory flag icons (SVG, React components, strings, CSS).",
  "main": "index.cjs",
  "scripts": {
    "fetch-flags": "node scripts/fetch-flags.js",
    "generate-states": "node scripts/generate-states.js",
    "optimize-flags": "node scripts/optimize-flags.js",
    "generate-string-flags": "node scripts/generate-string-flags.js",
    "generate-react-flags": "node scripts/generate-react-flags.js",
    "generate-css": "node scripts/generate-css.js",
    "zip-flags": "node scripts/create-flags-zip-archive.js",
    "update-exports": "node scripts/update-package-exports.js",
    "clean": "rimraf svg react string commonjs flags.css flags.zip source/states.json source/states.json.js",
    "build": "npm run clean && npm run generate-states && npm run optimize-flags && npm run generate-string-flags && npm run generate-react-flags && npm run generate-css && npm run zip-flags && npm run update-exports",
    "test": "node --test",
    "test:package": "node scripts/verify-package.js",
    "lint:package": "publint",
    "check:types": "attw --pack . --exclude-entrypoints ./flags.css --ignore-rules cjs-resolves-to-esm",
    "prepublishOnly": "npm run build && npm test && npm run lint:package && npm run check:types && npm run test:package"
  },
  "keywords": [
    "us",
    "usa",
    "state",
    "flag",
    "flags",
    "icons",
    "svg",
    "react"
  ],
  "author": "Mo-Ibra",
  "license": "MIT",
  "type": "module",
